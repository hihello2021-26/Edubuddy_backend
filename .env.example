# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/edubuddy

# Auth
JWT_SECRET=replace_this_with_a_long_random_secret

# Groq API (get a free key at https://console.groq.com/keys)
# Groq is the PRIMARY provider for: AI Chatbot, Career Guidance, Interview
# Questions, Study Planning, Roadmaps, General AI Assistant, Resume Builder
# text generation. If it fails (quota/429/outage/missing key), aiService.js
# automatically falls back to Gemini so these features stay working.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (get a free key at https://aistudio.google.com/app/apikey)
# Gemini is the PRIMARY provider for: Resume Analysis, ATS Score, Resume
# Improvement Suggestions, PDF/Image Analysis, and complex reasoning. It is
# also the Groq fallback provider, and the only embeddings provider for RAG.
# NOTE: gemini-2.0-flash was shut down by Google on 1 Jun 2026, and
# text-embedding-004 was deprecated on 14 Jan 2026 — using either ID makes
# every AI agent fail with a 404, even with a valid key. Use current models:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Web search provider for the Government Exam / News agents (optional but recommended).
# Any of these work - the searchService tries whichever key is present:
#  - Serper.dev (https://serper.dev) -> SERPER_API_KEY
#  - Tavily (https://tavily.com)     -> TAVILY_API_KEY
# If neither is set, agents fall back to a static seed list so the app still runs.
SERPER_API_KEY=
TAVILY_API_KEY=

# Cron schedule for the daily Gov Exam + News agents (default: 6:00 AM daily)
DAILY_AGENT_CRON=0 6 * * *
WEEKLY_AGENT_CRON=0 7 * * 0
ENABLE_CRON=false
